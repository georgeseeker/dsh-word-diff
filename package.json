{
  "name": "@local/dsh-word-diff",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Intra-line diff highlighting for the changed-files review tab: deleted lines keep a red background and the removed words get a deeper red, added lines keep a green background and the inserted words get a brighter green.",
  "license": "MIT",
  "author": "georgeseeker",
  "repository": { "type": "git", "url": "git+https://github.com/georgeseeker/dsh-word-diff.git" },
  "homepage": "https://github.com/georgeseeker/dsh-word-diff#readme",
  "bugs": { "url": "https://github.com/georgeseeker/dsh-word-diff/issues" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "diff", "word-diff", "review"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
